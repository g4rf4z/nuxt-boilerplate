{
  "name": "nuxt-app",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "description": "A modular, production-ready Nuxt boilerplate designed to quickly launch any kind of project with minimal configuration",
  "author": "Grégoire Pinte",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "db:generate": "drizzle-kit generate",
    "deps:clear": "rm -rf node_modules .nuxt",
    "deps:reset": "pnpm deps:clear && pnpm install && pnpm postinstall",
    "cleaninstall": "rm -rf pnpm-lock.yaml && pnpm deps:reset"
  },
  "dependencies": {
    "@nuxt/content": "3.8.2",
    "@nuxt/fonts": "0.12.1",
    "@nuxt/icon": "2.1.0",
    "@nuxt/image": "2.0.0",
    "@nuxt/ui": "4.2.1",
    "@nuxthub/core": "0.9.1",
    "@nuxtjs/i18n": "10.2.1",
    "@pinia/colada": "0.17.9",
    "@pinia/colada-nuxt": "0.2.4",
    "@pinia/nuxt": "0.11.3",
    "@vueuse/nuxt": "14.1.0",
    "better-sqlite3": "12.5.0",
    "lodash-es": "4.17.21",
    "nuxt": "4.2.1",
    "nuxt-auth-utils": "0.5.25",
    "nuxt-viewport": "2.3.1",
    "pinia": "3.0.4",
    "vue": "3.5.25",
    "vue-router": "4.6.3",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@antfu/eslint-config": "6.2.0",
    "@iconify-json/lucide": "1.2.77",
    "@nuxt/eslint": "1.11.0",
    "@types/lodash-es": "4.17.12",
    "drizzle-kit": "0.31.7",
    "eslint": "9.39.1",
    "sass": "1.94.2",
    "typescript": "5.9.3",
    "vue-tsc": "3.1.5",
    "wrangler": "4.51.0"
  }
}
