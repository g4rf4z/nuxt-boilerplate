{
  "name": "nuxt-app",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.12.4",
  "description": "A modular, production-ready Nuxt boilerplate designed to quickly launch any kind of project with minimal configuration",
  "author": "Grégoire Pinte",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "db:generate": "drizzle-kit generate",
    "deps:clear": "rm -rf node_modules .nuxt",
    "deps:reset": "pnpm deps:clear && pnpm install && pnpm postinstall",
    "cleaninstall": "rm -rf pnpm-lock.yaml && pnpm deps:reset"
  },
  "dependencies": {
    "@nuxt/content": "3.6.1",
    "@nuxt/fonts": "0.11.4",
    "@nuxt/icon": "1.14.0",
    "@nuxt/image": "1.10.0",
    "@nuxt/ui": "3.2.0",
    "@nuxthub/core": "0.9.0",
    "@nuxtjs/i18n": "9.5.6",
    "@pinia/colada": "0.17.1",
    "@pinia/colada-nuxt": "0.2.1",
    "@pinia/nuxt": "0.11.1",
    "@vueuse/nuxt": "13.4.0",
    "better-sqlite3": "12.1.1",
    "lodash-es": "4.17.21",
    "nuxt": "3.17.5",
    "nuxt-auth-utils": "0.5.20",
    "nuxt-viewport": "2.3.1",
    "pinia": "3.0.3",
    "vue": "3.5.17",
    "vue-router": "4.5.1",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@antfu/eslint-config": "4.16.1",
    "@iconify-json/lucide": "1.2.47",
    "@nuxt/eslint": "1.4.1",
    "@types/lodash-es": "4.17.12",
    "drizzle-kit": "0.31.4",
    "eslint": "9.29.0",
    "sass": "1.89.2",
    "typescript": "5.8.3",
    "vue-tsc": "2.2.10",
    "wrangler": "4.22.0"
  }
}
